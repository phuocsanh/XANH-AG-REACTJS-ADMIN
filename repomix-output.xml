});

// Schema cho hóa đơn
export const salesInvoiceSchema = z.object({
  customer_id: z.number().optional(),
  customer_name: z.string().min(1, 'Tên khách hàng là bắt buộc'),
  customer_phone: z.string().min(10, 'Số điện thoại phải có ít nhất 10 số'),
