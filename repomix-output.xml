                  <table style={{ tableLayout: 'fixed', width: '100%' }}>
                      <thead className="ant-table-thead">
                          <tr>
                              <th className="ant-table-cell">Nguyên liệu</th>
                              <th className="ant-table-cell">Số lượng & Đơn vị nhập</th>
