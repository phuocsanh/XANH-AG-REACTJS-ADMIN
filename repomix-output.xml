                  </Alert>
                </Grid>
              );
            })}
          </Grid>
          {warnings.length === 0 && (
            <Alert severity="success" sx={{ mt: 2 }}>
              Hiện tại không có cảnh báo bệnh hại nào ở mức CAO hoặc TRUNG BÌNH
            </Alert>
          )}
        </CardContent>
      </Card>
      </DraggableWidget>
      )}
