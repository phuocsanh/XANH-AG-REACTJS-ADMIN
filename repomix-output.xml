                                  </div>
                                )}
                              </div>
                            </List.Item>
                          )}
                        />
                      </div>
                    </Card>
                  </Col>
                </Row>
              </div>
            ) : (
              <Text type="secondary">
                Đang tải dữ liệu thời tiết...
              </Text>
            )}
        </Col>
      </Row>

      {/* Print Preview Modal */}
      <Modal
        title="Xem trước và In"
        open={isPrintModalVisible}
        onCancel={() => setIsPrintModalVisible(false)}
        width={900}
        footer={[
