            render={({ field }) => (
              <NumberInput
                {...field}
                min={0}
                disabled={isApproved}
                placeholder='Đơn giá'
                onChange={(value) => {
                  const cost = value || 0
                  field.onChange(cost)
                  
                  // Cập nhật thành tiền
                  const qty = getValues(`items.${index}.quantity`) || 0
                  setValue(`items.${index}.total_price`, qty * cost)
                }}
              />
            )}
