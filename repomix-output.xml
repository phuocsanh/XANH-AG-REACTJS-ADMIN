          </Card>
        </Col>
        
        {/* Weather Forecast Section */}
        <Col span={24}>
        
            {weatherForecast.length > 0 ? (
              <div>
                <Row gutter={16}>
                  
                  
                  <Col span={24} md={12} >
                    <Card 
