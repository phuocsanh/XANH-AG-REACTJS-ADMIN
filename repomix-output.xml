  lists: () => [...farmServiceCostKeys.all, 'list'] as const,
  list: (filters: SearchFarmServiceCostDto) => [...farmServiceCostKeys.lists(), filters] as const,
  details: () => [...farmServiceCostKeys.all, 'detail'] as const,
