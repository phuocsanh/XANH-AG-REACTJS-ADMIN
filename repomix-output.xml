            {printSections.spray && sprayingRecommendations.length > 0 && (
              <div className="print-section" style={{ marginBottom: '30px' }}>
                <Title level={4}>Thời điểm phun thuốc tốt nhất</Title>
                <div 
                  style={{ 
                    marginTop: '15px',
                    display: 'grid',
                    gridTemplateColumns: 'repeat(2, 1fr)',
