            Xác nhận thanh toán
          </Button>,
        ]}
        width={500}
      >
        {viewingInvoice && (
          <div className='mt-4'>
            <Card className='mb-4 bg-gray-50'>
              <div className='text-gray-500 text-sm'>Số tiền còn nợ</div>
              <div className='text-2xl font-bold text-red-600'>
