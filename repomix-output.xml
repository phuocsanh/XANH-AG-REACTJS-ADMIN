                { text: "Đã trao", value: "issued" },
              ],
              filteredValue: filters.status ? [filters.status] : null,
              onFilter: () => true,
            },
            {
              title: "Trúng thưởng lúc",
              key: "reserved_at",
              width: 170,
              render: (_, record: any) =>
                record.reserved_at
