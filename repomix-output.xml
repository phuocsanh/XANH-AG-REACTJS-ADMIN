/**
 * Trang báo cáo lợi nhuận theo mùa vụ
 * Dashboard tổng quan về doanh thu, chi phí, lợi nhuận
 */

import React, { useState } from 'react';
import {
  Card,
  Row,
  Col,
  Statistic,
  Table,
  Spin,
  Alert,
  Select,
  Divider,
  Typography,
