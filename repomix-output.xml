        </ToolbarButton>
        <div
          style={{
            width: "1px",
            height: "24px",
            backgroundColor: "#d1d5db",
            margin: "4px 2px",
          }}
        />
        <ToolbarButton
          onClick={() => editor.chain().focus().toggleBulletList().run()}
          isActive={editor.isActive("bulletList")}
          title='Danh sách dấu chấm'
        >
          • List
        </ToolbarButton>
        <div
          style={{
            width: "1px",
