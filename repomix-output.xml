      >
        <div className="mb-4">
          <Text strong>Chọn nội dung cần in:</Text>
          <div className="mt-2 space-y-2">
            <div>
              <Checkbox 
                checked={printSections.mix}
                onChange={() => handlePrintSectionChange('mix')}
                disabled={!mixResult}
              >
                Kết quả Phân tích Phối trộn
