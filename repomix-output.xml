export interface ReturnApiResponse {
  id: number
  code: string
  receipt_id?: number
  supplier_id: number
  supplier_name?: string
  total_amount: string
  reason: string
  status: string | number  // Hỗ trợ cả string ('draft') và number (0)
  notes?: string
