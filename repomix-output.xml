/* Global styles to prevent horizontal scroll */
html,
body {
  @apply overflow-x-hidden;
}

#root {
  @apply overflow-x-hidden;
}

/* Ensure all elements fit within viewport width */
* {
  @apply box-border;
}

/* Prevent horizontal scroll on all screen sizes */
.container {
  @apply max-w-full overflow-x-hidden;
}

/* Custom CSS để giảm chiều cao hàng trong tất cả các bảng */
.ant-table-small .ant-table-tbody > tr > td {
  padding: 6px 8px !important;
}

.ant-table-small .ant-table-thead > tr > th {
  padding: 6px 8px !important;
}

/* Giảm kích thước ảnh trong bảng */
.ant-table-small .ant-image {
  line-height: 1 !important;
}

/* Override Ant Design Button Primary với gradient xanh */
.ant-btn-primary {
  background: var(--gradient-button) !important;
  border: none !important;
  color: #fff !important;
  transition: all 0.3s ease !important;
}

.ant-btn-primary:hover:not(:disabled) {
  background: var(--gradient-primary) !important;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3) !important;
}

.ant-btn-primary:active:not(:disabled) {
  background: var(--gradient-primary) !important;
  transform: translateY(0);
}

.ant-btn-primary:disabled {
  background: linear-gradient(135deg, #9ca3af 0%, #6b7280 100%) !important;
  opacity: 0.6;
}

/* Override cho Button danger khi có type="primary" */
.ant-btn-primary.ant-btn-dangerous {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%) !important;
}

.ant-btn-primary.ant-btn-dangerous:hover:not(:disabled) {
  background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%) !important;
}

/* Mobile optimization - Giảm padding cho Card */
@media (max-width: 768px) {
  .ant-card-body {
    padding: 8px !important;
  }
  
  .ant-card-head {
    padding: 6px 8px !important;
    min-height: auto !important;
  }
  
  .ant-card-head-title {
    padding: 2px 0 !important;
    font-size: 13px !important;
  }
  
  /* Giảm spacing cho form elements */
  .ant-form-item {
    margin-bottom: 6px !important;
  }
  
  .ant-input, .ant-select, .ant-input-number {
    font-size: 14px !important;
  }
  
  /* Giảm padding cho Title */
  .ant-typography h5 {
    margin-bottom: 2px !important;
    font-size: 12px !important;
  }
  
  /* Giảm padding cho Alert */
  .ant-alert {
    padding: 4px 8px !important;
  }
  
  /* Giảm margin cho Divider */
  .ant-divider {
    margin: 8px 0 !important;
  }
  
  /* Fix sidebar bị che bởi header */
  .sidebar {
    padding-top: 70px !important;
  }
  
  /* Override padding cho tất cả page content - QUAN TRỌNG */
  /* Giảm p-6 (24px) xuống p-2 (8px) trên mobile */
  .p-6 {
    padding: 0.5rem !important; /* 8px */
  }
  
  .p-4 {
    padding: 0.5rem !important; /* 8px */
  }
  
  /* Giữ padding top/bottom nhưng giảm left/right */
  .px-6 {
    padding-left: 0.5rem !important;
    padding-right: 0.5rem !important;
  }
  
  .px-4 {
    padding-left: 0.5rem !important;
    padding-right: 0.5rem !important;
  }
}

/* ==========================================================================
   CUSTOM PRODUCT FORM COMPACT STYLES
   ========================================================================== */
