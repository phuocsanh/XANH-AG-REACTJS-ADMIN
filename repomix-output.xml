                />
            ))}
        </div>
      )}
      
      {fields.length === 0 && (
        <div className="py-10 text-center text-gray-400 border-t border-gray-100 bg-gray-50/50">
            <PlusOutlined style={{ fontSize: 32, marginBottom: 12, opacity: 0.5 }} />
