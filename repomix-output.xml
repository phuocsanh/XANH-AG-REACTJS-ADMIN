      tax_selling_price: 0,
      total_price: 0,
      individual_shipping_cost: 0,
      discountType: 'fixed_amount',
      discountValue: 0,
      discount_amount: 0,
      taxable_quantity: 0,
      unit_id: undefined,
      conversion_factor: 1,
      base_quantity: 1,
      conversions: [],
