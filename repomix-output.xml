            {printSections.mix && mixResult && (
              <div className="print-section" style={{ marginBottom: '30px' }}>
                <Title level={4}>Kết quả Phân tích Phối trộn</Title>
                <div 
                  style={{ 
                    padding: '15px', 
                    border: '1px solid #e8e8e8',
                    borderRadius: '4px',
                    backgroundColor: '#fafafa'
                  }}
                  dangerouslySetInnerHTML={{ 
                    __html: mixResult
                      .replace(/\n\n/g, '</p><p>')
                      .replace(/\n/g, '<br>')
                      .replace(/^(<br>)+|(<br>)+$/g, '')
                      .replace(/^|$/, '<p>')
                      .replace(/<p><\/p>/g, '')
