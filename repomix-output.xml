                  { label: '0-7 ngày', bucket: receivablesData?.aging['0_7_days'] },
                  { label: '8-30 ngày', bucket: receivablesData?.aging['8_30_days'] },
                  { label: '31-90 ngày', bucket: receivablesData?.aging['31_90_days'] },
