    }
  );
  
  
  const createMutation = useCreateSalesInvoiceMutation();
  const updateMutation = useUpdateSalesInvoiceMutation();

  // State để lưu kết quả tính toán
  const [calculatedProfit, setCalculatedProfit] = useState({
