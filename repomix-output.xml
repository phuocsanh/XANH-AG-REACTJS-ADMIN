      description: 'Quà tặng cho khách hàng, chi phí kỹ thuật, giao hàng'
    },
  ] : [];

  const columns = [
    {
      title: 'Loại chi phí',
      dataIndex: 'type',
      key: 'type',
      render: (text: string, record: typeof expenseData[0]) => (
        <Space>
          {record.icon}
          <Text strong>{text}</Text>
        </Space>
      ),
    },
    {
      title: 'Mô tả',
      dataIndex: 'description',
      key: 'description',
    },
    {
      title: 'Số tiền',
      dataIndex: 'amount',
      key: 'amount',
      align: 'right' as const,
