  "/change-password",  // Đổi mật khẩu
]

export const AI_DEMO_ROUTE = "/ai-demo"

export const isPublicRoute = (pathname: string) => {
  return PUBLIC_ROUTES.some((route) => pathname.startsWith(route))
}

